# GSP configuration. Copy to .env and adjust:  cp .env.example .env
# .env is gitignored; never commit real credentials.

# Where Garmin login tokens are stored (relative to the repo, or absolute).
GSP_TOKENSTORE=.secrets/garminconnect

# Where template backups are written before each update.
GSP_BACKUP_DIR=backups

# How many days back to look for activities.
GSP_DAYS=7

# Device to send updated workouts to. Empty = last used device.
# Find it with:  ./update.sh dump devices
GSP_DEVICE_ID=

# Optional: lets the script re-login on its own when tokens expire (~1 year).
# Leave empty to be prompted by `./update.sh login` instead (recommended).
GARMIN_EMAIL=
GARMIN_PASSWORD=
